rules_version = '2';

// Tests: `npm run test:rules` (corre contra el emulador de Firestore).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []);
    }

    function isAdmin() {
      return signedIn() && roles().hasAny(['admin', 'superadmin']);
    }

    function validNickname(nickname) {
      return nickname is string && nickname.size() >= 1 && nickname.size() <= 30;
    }

    // La foto de perfil es la de la cuenta de Google o la de por defecto (no se usa Storage).
    function validImage(image) {
      return image == 'assets/img/playerAvatar.png'
        || (image is string && image.matches('https://[a-z0-9-]+[.]googleusercontent[.]com/.+'));
    }

    // ---------- Jugadores ----------
    // Cada uno crea su perfil (sin roles ni estadísticas) y después solo puede cambiar su apodo y su foto
    // (la app la actualiza cuando la cambian en Google).
    // Los admins actualizan estadísticas, crean a los "amigos" sin cuenta y arrancan la temporada.
    // El email no se guarda acá: este documento lo leen todos los jugadores.
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'roles', 'played', 'won', 'image', 'googleLogin', 'lastGames'])
        && request.resource.data.roles == ['player']
        && request.resource.data.played == 0
        && request.resource.data.won == 0
        && validNickname(request.resource.data.nickname)
        && validImage(request.resource.data.image)
      );

      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'image'])
        && validNickname(request.resource.data.nickname)
        && validImage(request.resource.data.image)
      );

      allow delete: if false;
    }

    // ---------- Partidos ----------
    match /matches/{matchId} {

      function subscriberAfter(playerId) {
        return getAfter(/databases/$(database)/documents/matches/$(matchId)/subscribers/$(playerId));
      }

      function subscriberExistsAfter(playerId) {
        return existsAfter(/databases/$(database)/documents/matches/$(matchId)/subscribers/$(playerId));
      }

      function subscriberBefore(playerId) {
        return get(/databases/$(database)/documents/matches/$(matchId)/subscribers/$(playerId));
      }

      // Lo único que cambia es la lista de anotados, y el partido sigue abierto.
      function onlyPlayersListChanges() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playersList'])
          && resource.data.enabled == true;
      }

      // Anotarse (o anotar a un amigo): se agrega un solo jugador, sin pasarse del cupo,
      // y en la misma escritura se crea su documento de anotado.
      function isJoin() {
        let before = resource.data.playersList;
        let after = request.resource.data.playersList;
        let added = after.removeAll(before);
        return after.size() == before.size() + 1
          && after.hasAll(before)
          && added.size() == 1
          && after.size() <= resource.data.maxPlayers
          && subscriberExistsAfter(added[0]);
      }

      // Bajarse (o bajar a un amigo que anotó uno): se saca un solo jugador
      // y en la misma escritura se borra su documento de anotado.
      function isLeave() {
        let before = resource.data.playersList;
        let after = request.resource.data.playersList;
        let removed = before.removeAll(after);
        return after.size() == before.size() - 1
          && before.hasAll(after)
          && removed.size() == 1
          && !subscriberExistsAfter(removed[0])
          && (removed[0] == request.auth.uid || subscriberBefore(removed[0]).data.friendOf == request.auth.uid);
      }

      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyPlayersListChanges() && (isJoin() || isLeave()));

      match /subscribers/{playerId} {

        function matchAfter() {
          return getAfter(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function matchBefore() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function userPath() {
          return /databases/$(database)/documents/users/$(playerId);
        }

        // Las estadísticas del anotado son las del jugador (o 0 para un amigo nuevo): no se pueden inventar.
        function realStats() {
          let data = request.resource.data;
          return (exists(userPath())
              && data.played == get(userPath()).data.played && data.won == get(userPath()).data.won)
            || (!exists(userPath()) && data.played == 0 && data.won == 0);
        }

        function validSubscriber() {
          let data = request.resource.data;
          return data.keys().hasOnly(['nickname', 'image', 'played', 'won', 'friendOf', 'lastGames'])
            && validNickname(data.nickname)
            && (
              (playerId == request.auth.uid && data.friendOf == '')
              || (playerId != request.auth.uid && data.friendOf == request.auth.uid)
            )
            && realStats();
        }

        allow read: if signedIn();

        // Se crea junto con el alta en `playersList` (ahí se controla el cupo).
        allow create: if isAdmin() || (
          signedIn()
          && matchBefore().enabled == true
          && matchAfter().playersList.hasAny([playerId])
          && validSubscriber()
        );

        allow delete: if isAdmin() || (
          signedIn()
          && (playerId == request.auth.uid || resource.data.friendOf == request.auth.uid)
          && matchBefore().enabled == true
          && !matchAfter().playersList.hasAny([playerId])
        );

        allow update: if isAdmin();
      }

      // Equipos: los arman los admins.
      match /{team}/{playerId} {
        allow read: if signedIn() && (team == 'teamWhite' || team == 'teamBlack');
        allow write: if isAdmin() && (team == 'teamWhite' || team == 'teamBlack');
      }
    }

    // ---------- Temporada ----------
    // Fecha en que empezó la temporada actual. Se anota en el mismo batch que divide los partidos
    // (`DbService.startNewSeason`), y no se puede volver a anotar hasta el día siguiente:
    // así un doble toque o dos admins a la vez no dividen los partidos dos veces.
    match /config/season {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['startedAt', 'startedBy'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.startedBy == request.auth.uid
        && (resource == null || resource.data.startedAt < request.time - duration.value(1, 'd'));
    }

    // ---------- Novedades ----------

    // Novedades del dashboard.
    match /card-news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Novedades de la versión y versión publicada: se cargan desde la consola.
    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    match /version/{versionId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
